/* =========================================================
   GENERAL
   ========================================================= */

QWidget {
    background-color: #120F1D;
    color: #F7F3FF;
    font-family: "Segoe UI";
    font-size: 14px;
}

QLabel {
    background-color: transparent;
}


/* =========================================================
   AUTH WINDOWS
   ========================================================= */

QWidget#authRoot {
    background-color: #120F1D;
}

QFrame#loginCard {
    background-color: #1C1729;
    border: 1px solid #2E2540;
    border-radius: 22px;
}

QLabel#titleLabel {
    color: #FFFFFF;
    font-size: 32px;
    font-weight: 700;
}

QLabel#subtitleLabel {
    color: #AAA0BC;
    font-size: 14px;
}

QLabel#fieldLabel {
    color: #E9E2F5;
    font-size: 13px;
    font-weight: 600;
}

QLabel#bottomText {
    color: #9389A7;
    font-size: 14px;
}


/* =========================================================
   INPUTS
   ========================================================= */

QLineEdit {
    background-color: #15111F;
    color: #FFFFFF;

    border: 1px solid #46385F;
    border-radius: 12px;

    padding: 11px 14px;

    min-height: 24px;

    selection-background-color: #8B5CF6;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    background-color: #181222;
    border: 1px solid #9B6CFF;
}

QLineEdit:disabled {
    background-color: #181421;
    color: #716A7D;
    border-color: #30283D;
}


/* =========================================================
   DEFAULT BUTTON
   ========================================================= */

QPushButton {
    background-color: #211A2C;
    color: #E9E2F5;

    border: 1px solid #46385F;
    border-radius: 9px;

    padding: 8px 12px;
}

QPushButton:hover {
    background-color: #2A2039;
    border-color: #7450B6;
}

QPushButton:pressed {
    background-color: #332448;
}

QPushButton:disabled {
    background-color: #292332;
    color: #766D84;
    border-color: #3A3048;
}


/* =========================================================
   PRIMARY BUTTON
   ========================================================= */

QPushButton#primaryButton {
    background-color: #8B5CF6;
    color: #FFFFFF;

    border: none;
    border-radius: 12px;

    padding: 11px 18px;

    font-weight: 700;
}

QPushButton#primaryButton:hover {
    background-color: #9D72FF;
}

QPushButton#primaryButton:pressed {
    background-color: #7547D8;
}

QPushButton#primaryButton:disabled {
    background-color: #4B4160;
    color: #978DA9;
}


/* =========================================================
   SMALL PRIMARY BUTTON
   ========================================================= */

QPushButton#smallPrimaryButton {
    background-color: #8B5CF6;
    color: #FFFFFF;

    border: none;
    border-radius: 10px;

    padding: 10px 15px;

    font-weight: 600;
}

QPushButton#smallPrimaryButton:hover {
    background-color: #9D72FF;
}

QPushButton#smallPrimaryButton:pressed {
    background-color: #7547D8;
}


/* =========================================================
   LINK BUTTON
   ========================================================= */

QPushButton#linkButton {
    background-color: transparent;
    color: #A77BFF;

    border: none;

    padding: 4px 2px;

    font-size: 14px;
    font-weight: 700;
}

QPushButton#linkButton:hover {
    background-color: transparent;
    color: #C5AAFF;

    text-decoration: underline;
}

QPushButton#linkButton:pressed {
    background-color: transparent;
    color: #8B5CF6;
}


/* =========================================================
   EYE BUTTON
   ========================================================= */

QPushButton#eyeButton {
    background-color: transparent;
    color: #A77BFF;

    border: none;

    padding: 0px;
    margin: 0px;

    font-size: 20px;

    min-width: 36px;
    max-width: 36px;

    min-height: 36px;
    max-height: 36px;
}

QPushButton#eyeButton:hover {
    background-color: transparent;
    color: #C6AAFF;
    border: none;
}

QPushButton#eyeButton:pressed {
    background-color: transparent;
    color: #8B5CF6;
    border: none;
}


/* =========================================================
   LOGOUT / DANGER BUTTON
   ========================================================= */

QPushButton#logoutButton {
    background-color: transparent;
    color: #FF858F;

    border: 1px solid #A84650;
    border-radius: 9px;

    padding: 8px 15px;
}

QPushButton#logoutButton:hover {
    background-color: #382028;
    border-color: #D05865;
}

QPushButton#logoutButton:pressed {
    background-color: #471F29;
}

QPushButton#logoutButton:disabled {
    background-color: transparent;
    color: #725D65;
    border-color: #50353C;
}


/* =========================================================
   ERRORS AND USERNAME STATUS
   ========================================================= */

QLabel#errorLabel {
    color: #FF7D9C;
    font-size: 12px;
}

QLabel#usernameStatus {
    font-size: 12px;
    font-weight: 500;

    padding: 0px 2px;
}

QLabel#usernameStatus[state="available"] {
    color: #8FE3B1;
}

QLabel#usernameStatus[state="error"] {
    color: #FF7D9C;
}

QLabel#usernameStatus[state="checking"] {
    color: #B7A7CF;
}


/* =========================================================
   MAIN WINDOW - TOP BAR
   ========================================================= */

QFrame#topBar {
    background-color: #1C1729;
    border-bottom: 1px solid #342947;
}

QLabel#currentUserLabel {
    color: #FFFFFF;

    font-size: 16px;
    font-weight: 600;
}


/* =========================================================
   MAIN WINDOW - PANELS
   ========================================================= */

QFrame#leftPanel {
    background-color: #15111F;
    border-right: 1px solid #342947;
}

QFrame#rightPanel {
    background-color: #100D18;
}

QLabel#sectionTitle {
    color: #FFFFFF;

    font-size: 20px;
    font-weight: 700;
}


/* =========================================================
   CHAT LIST
   ========================================================= */

QListWidget#chatList {
    background-color: #15111F;

    border: none;
    outline: none;
}

QListWidget#chatList::item {
    background-color: transparent;

    border: none;
    border-radius: 10px;

    padding: 0px;
    margin: 2px 0px;
}

QListWidget#chatList::item:hover {
    background-color: #241B31;
}

QListWidget#chatList::item:selected {
    background-color: #49346E;
}

QWidget#chatItemWidget {
    background-color: transparent;
}

QLabel#avatarLabel {
    background-color: #8B5CF6;
    color: #FFFFFF;

    border-radius: 23px;

    font-size: 15px;
    font-weight: 700;
}

QLabel#chatItemName {
    color: #FFFFFF;

    font-size: 14px;
    font-weight: 700;
}

QLabel#chatItemPreview {
    color: #AAA0BC;

    font-size: 12px;
}

QLabel#chatItemTime {
    color: #8E829F;

    font-size: 11px;
}

QLabel#unreadBadge {
    background-color: #8B5CF6;
    color: #FFFFFF;

    border-radius: 12px;

    font-size: 11px;
    font-weight: 700;
}


/* =========================================================
   CHAT HEADER
   ========================================================= */

QFrame#chatHeader {
    background-color: #1C1729;
    border-bottom: 1px solid #342947;
}

QLabel#chatNameLabel {
    color: #FFFFFF;

    font-size: 17px;
    font-weight: 700;
}

QLabel#chatStatusLabel {
    color: #A99CBF;

    font-size: 12px;
}


/* =========================================================
   MESSAGE AREA
   ========================================================= */

QScrollArea#messagesScroll {
    background-color: #100D18;

    border: none;
}

QWidget#messagesContainer {
    background-color: #100D18;
}

QWidget#emptyStateContainer {
    background-color: transparent;
}

QLabel#emptyChatLabel {
    background-color: transparent;
    color: #CFC4E8;

    font-size: 16px;
    font-weight: 500;

    padding: 8px;
}


/* =========================================================
   MESSAGE BUBBLES
   ========================================================= */

QFrame#ownMessageBubble {
    background-color: #6746A5;

    border-radius: 13px;
}

QFrame#otherMessageBubble {
    background-color: #211A2C;

    border-radius: 13px;
}

QLabel#messageText {
    background-color: transparent;
    color: #FFFFFF;

    font-size: 14px;
}

QLabel#messageSender {
    background-color: transparent;
    color: #C6ADFF;

    font-size: 12px;
    font-weight: 700;
}

QLabel#messageTime {
    background-color: transparent;
    color: #B0A4C2;

    font-size: 10px;
}

QLabel#messageStatus {
    background-color: transparent;
    color: #D2BCFF;

    font-size: 11px;
    font-weight: 700;
}


/* =========================================================
   MESSAGE INPUT PANEL
   ========================================================= */

QFrame#messagePanel {
    background-color: #181321;
    border-top: 1px solid #342947;
}


/* =========================================================
   SPLITTER
   ========================================================= */

QSplitter::handle {
    background-color: #342947;

    width: 1px;
}


/* =========================================================
   ADMIN TABS
   ========================================================= */

QTabWidget::pane {
    background-color: #15111F;

    border: 1px solid #342947;
    border-radius: 8px;

    top: -1px;
}

QTabBar::tab {
    background-color: #181321;
    color: #AAA0BC;

    border: 1px solid #342947;
    border-bottom: none;

    padding: 8px 14px;

    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #261C35;
    color: #FFFFFF;

    border-color: #60458B;
}

QTabBar::tab:hover:!selected {
    background-color: #21182D;
    color: #E6DDF2;
}


/* =========================================================
   ADMIN TABLE
   ========================================================= */

QTableWidget {
    background-color: #15111F;
    color: #F7F3FF;

    border: 1px solid #30263F;
    border-radius: 7px;

    gridline-color: #30263F;

    selection-background-color: #49346E;
    selection-color: #FFFFFF;

    outline: none;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #49346E;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #1C1729;
    color: #F7F3FF;

    border: none;
    border-right: 1px solid #342947;
    border-bottom: 1px solid #342947;

    padding: 7px;

    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #1C1729;

    border: none;
    border-right: 1px solid #342947;
    border-bottom: 1px solid #342947;
}


/* =========================================================
   AUDIT LOG
   ========================================================= */

QTextBrowser {
    background-color: #15111F;
    color: #F7F3FF;

    border: 1px solid #342947;
    border-radius: 7px;

    padding: 8px;

    selection-background-color: #6746A5;
    selection-color: #FFFFFF;
}


/* =========================================================
   CONTEXT MENU
   ========================================================= */

QMenu {
    background-color: #1C1729;
    color: #F7F3FF;

    border: 1px solid #46385F;

    padding: 5px;
}

QMenu::item {
    background-color: transparent;

    padding: 7px 24px 7px 10px;
}

QMenu::item:selected {
    background-color: #49346E;

    border-radius: 5px;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

QScrollBar:vertical {
    background-color: #100D18;

    width: 8px;

    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #4B3A63;

    min-height: 30px;

    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #674A8D;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #100D18;

    height: 8px;

    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #4B3A63;

    min-width: 30px;

    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #674A8D;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}